{
  "expo": {
    "name": "J-Link RTT Terminal",
    "slug": "jlink-rtt-terminal",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.nikohost.jlinkrtt",
      "versionCode": 2,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F1115"
      }
    },
    "plugins": [
      "./plugins/withUsbHost"
    ],
    "extra": {
      "eas": {}
    },
    "icon": "./assets/icon.png"
  }
}