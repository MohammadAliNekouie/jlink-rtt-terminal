{
  "expo": {
    "name": "J-Link RTT Terminal",
    "slug": "jlink-rtt-terminal",
    "version": "1.2.14",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.nikohost.jlinkrtt",
      "versionCode": 17,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0001FF"
      }
    },
    "plugins": [
      "./plugins/withUsbHost",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "f1f1c1da-77a1-4a04-b736-d35a519de74b"
      }
    },
    "icon": "./assets/icon.png"
  }
}
